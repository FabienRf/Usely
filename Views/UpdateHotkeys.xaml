<Window x:Class="Usely.Views.UpdateHotkeys"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Hotkeys"
        Height="300"
        Width="300"
        Focusable="True">

    <!-- Window to ask for hotkey input -->
    <Border Background="#F0F0F0"
            Margin="10"
            Padding="20"
            BorderBrush="Black"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <TextBlock VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="14"
                   Foreground="#333">
            <Run Text="ctrl+shift is automatically,"/>
            <LineBreak/>
            <Run Text="Press the 3rd hotkeys..."/>
        </TextBlock>
    </Border>
</Window>
